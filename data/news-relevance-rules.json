      "pattern": "\\b(?:bypass|evad(?:e|ing)|disabl(?:e|es|ed)|attacks?|poison(?:ed|ing)?|leak(?:ed|s|age)?|security|guardrails?|insider threats?)\\b",
      "incident": true,
      "context": "\\b(?:AI agents?|LLMs?|language models?|safety classifiers?|AI security|agent[ -]planning|prompt|sandboxes?)\\b"
    },
    {
      "label": "identity security",
      "pattern": "\\b(?:passkeys?|passwordless|password managers?|password security|multi[ -]?factor authentication|two[ -]?factor authentication|MFA|FIDO2?|zero[ -]trust|identity security|access controls?|OAuth|SSO|continuous authorization)\\b",
      "incident": false
    },
    {
      "label": "threat research",
      "pattern": "\\b(?:threat model(?:l?ing)?|threat hunt(?:ing)?|threat intelligence|threat landscape|threat actors?|incident response|digital forensics|security operations|red team(?:ing)?|penetration test(?:ing)?|pentest(?:ing)?|security audit|CTF competitions?|capture[ -]the[ -]flag|digital defense report|cyber drill)\\b|\\b(?:CISOs?|security governance|cybersecurity awareness)\\b",
      "incident": false
    },
    {
      "label": "cryptographic security",
      "pattern": "\\b(?:SSL/TLS|TLS|certificate authorit(?:y|ies)|CA certificates?|certificate ecosystems?|post[ -]quantum authentication|quantum decryption|cryptograph(?:y|ic))\\b|\\b(?:trust certificates?|CA keys?|PKI)\\b",
      "incident": false
