      "incident": true
    },
    {
      "label": "threat research",
      "pattern": "\\b(?:espionage campaign|threat campaigns?|APT[- ]?\\d{1,4}|C&C|command[ -]and[ -]control)\\b",
      "context": "\\b(?:AI|cyber\\w*|software|network|malware|attack|attacks|C&C|threat|actor)\\b",
