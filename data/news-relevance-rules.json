      "incident": true
    },
    {
      "label": "supply chain",
      "pattern": "\\bsupply[\\s-]+chain[\\s-]+(?:attacks?|compromise|breach)\\b",
      "incident": true
    },
    {
      "label": "cryptocurrency theft",
      "pattern": "\\b(?:crypto(?:currency)?|bitcoin|blockchain|digital[\\s-]+assets?)[\\s\\S]{0,100}\\b(?:hack(?:s|ed|ers?|ing)?|theft|stolen|heist|drained|breach)\\b|\\b(?:theft|stolen|heist|drained)[\\s\\S]{0,100}\\b(?:crypto(?:currency)?|bitcoin|blockchain|digital[\\s-]+assets?)\\b",
      "incident": true
    },
    {
      "label": "system compromise",
