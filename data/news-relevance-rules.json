      "pattern": "\\b(?:misplaced|missing|lost|cannot account for)[\\s\\S]{0,90}\\b(?:data storage|storage|classified|sensitive)[\\s\\S]{0,35}\\b(?:devices|records|data)\\b",
      "incident": true
