    },
    {
      "label": "malicious software",
      "pattern": "\\b(?:malicious|backdoored|poisoned|trojanized)[\\s\\S]{0,60}\\b(?:packages?|extensions?|software|code|APIs?|dependencies|repositories|models?)\\b|\\b(?:packages?|extensions?|repositories|software)[\\s\\S]{0,70}\\b(?:poisoned|backdoored|hijack(?:ed|ing)?|malicious)\\b|\\bmalicious[ -]+(?:emails?|websites?|documents?|instructions?|prompts?|plugins?)\\b",
      "incident": true
