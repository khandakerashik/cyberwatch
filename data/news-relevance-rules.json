      "incident": true
    },
    {
      "label": "ransomware",
      "pattern": "\\b(?:ransomware|cyber[\\s-]*extortion)\\b|র‍্যানসমওয়্যার|র‍্যানসমওয়্যার",
      "incident": true
    },
    {
      "label": "malware",
      "pattern": "\\b(?:malware|spyware|botnets?|keyloggers?|rootkits?|infostealers?|info[ -]?stealers?|ransomware)\\b|ম্যালওয়্যার|ম্যালওয়্যার",
      "incident": true
    },
    {
      "label": "malware",
      "pattern": "\\btrojans?\\b",
      "incident": true,
