    {
      "label": "security update",
      "pattern": "\\bsecurity[\\s-]+(?:updates?|patch(?:es|ed)?|releases?|advisories|advisory|fix(?:es|ed)?)\\b",
      "incident": true
    },
    {
      "label": "backdoor",
