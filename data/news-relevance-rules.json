      "incident": true
    },
    {
      "label": "DDoS",
      "pattern": "\\bddos\\b|\\b(?:distributed[\\s-]+)?denial[\\s-]+of[\\s-]+service\\b",
      "incident": true
    },
    {
      "label": "zero-day",
      "pattern": "\\b(?:zero|0)[\\s-]*days?\\b",
      "incident": true
    },
    {
      "label": "vulnerability",
      "pattern": "\\bCVE-\\d{4}-\\d{4,}\\b|\\b(?:remote code execution|arbitrary code execution|SQL injection|command injection|cross[ -]site scripting|server[ -]side request forgery|RCE|SSRF|XSS|XXE|IDOR|CSRF)\\b",
      "incident": true
    },
    {
      "label": "vulnerability",
      "pattern": "\\b(?:vulnerabilit(?:y|ies)|security flaws?|security bugs?|flaws?|code execution|buffer overflow|use[ -]after[ -]free|memory corruption|auth(?:entication|orization)?[ -]+bypass)\\b",
      "incident": true,
