{
  "version": 1,
  "maxTitleChars": 1000,
  "maxLeadChars": 1600,
  "signals": [
    {
      "label": "cyberattack",
      "pattern": "\\bcyber[\\s-]*(?:attacks?|assaults?|incidents?|war(?:fare)?|espionage)\\b|সাইবার\\s*(?:আক্রমণ|হামলা|অ্যাটাক)",
      "incident": true
    },
    {
      "label": "cybersecurity",
      "pattern": "\\b(?:cyber[\\s-]*(?:security|crime|criminals?|threats?|defen[cs]e|risks?|drills?|alerts?)|infosec|information security|application security|network security|cloud security|endpoint security|AI security|LLM security|API security)\\b|সাইবার\\s*(?:নিরাপত্তা|সিকিউরিটি|ড্রিল|মহড়া|মহড়া|সতর্কতা)|(?<![A-Za-z0-9_])(?:cybersécurité|cybersicherheit|ciberseguridad|cybersicurezza|sicurezza informatica|vulnerabilità informatiche)(?![A-Za-z0-9_])",
      "incident": false
    },
    {
      "label": "hack",
      "pattern": "\\b(?:hackers?|hacktivis(?:t|m)s?)\\b|হ্যাকার|হ্যাকিং",
      "incident": true,
      "reject": "\\b(?:life|kitchen|cooking|beauty|fashion|travel|cleaning|gardening|productivity|sleep|diet|fitness|money[ -]+saving)[ -]+hacks?\\b|\\bhack[ -]+(?:your|the)[ -]+(?:sleep|diet|routine|workout)\\b|\\bhackathons?\\b|\\bhack(?:s|ed|ing)?[ -]+(?:down[ -]+)?(?:trees?|wood|branches?|bushes?)\\b"
    },
    {
      "label": "hack",
      "pattern": "\\bhack(?:s|ed|ing)?\\b",
      "incident": true,
      "context": "\\b(?:cyber\\w*|software|computers?|networks?|servers?|websites?|online|digital|databases?|cloud|applications?|apps?|browsers?|firmware|routers?|firewalls?|VPNs?|APIs?|SSH|OAuth|authentication|credentials?|passwords?|accounts?|emails?|crypto(?:currency)?|bitcoin|blockchain|tokens?|ransomware|malware|spyware|Windows|Linux|Android|iOS|GitLab|NGINX|Node[ .]?js|OpenSSL|libraries|library|packages?|dependencies|kernel|operating systems?|LLMs?|AI agents?|AI models?|guardrails?|sandboxes?|code|HTTP|DNS|SS7|Diameter|PLC|SCADA|critical infrastructure|AI|IT systems?|admins?|developers?|devs?|modules?|PHP|Drupal|web|mobile|phones?|games?|information|records?|files|leaked|secrets?|exchanges?)\\b",
      "reject": "\\b(?:life|kitchen|cooking|beauty|fashion|travel|cleaning|gardening|productivity|sleep|diet|fitness|money[ -]+saving)[ -]+hacks?\\b|\\bhack[ -]+(?:your|the)[ -]+(?:sleep|diet|routine|workout)\\b|\\bhackathons?\\b|\\bhack(?:s|ed|ing)?[ -]+(?:down[ -]+)?(?:trees?|wood|branches?|bushes?)\\b"
    },
    {
