    {
      "label": "exploitation",
      "pattern": "\\b(?:exploit(?:ed|ation|s)?|attackers?|intrusions?|interception|hijack(?:s|ed|ing)?|hardware implant|exfiltrat(?:ion|e|ed))\\b",
      "incident": true,
      "context": "\\b(?:cyber\\w*|software|computers?|networks?|servers?|websites?|online|digital|databases?|cloud|applications?|apps?|browsers?|firmware|routers?|firewalls?|VPNs?|APIs?|SSH|OAuth|authentication|credentials?|passwords?|accounts?|emails?|crypto(?:currency)?|bitcoin|blockchain|tokens?|ransomware|malware|spyware|Windows|Linux|Android|iOS|GitLab|NGINX|Node[ .]?js|OpenSSL|libraries|library|packages?|dependencies|kernel|operating systems?|LLMs?|AI agents?|AI models?|guardrails?|sandboxes?|code|HTTP|DNS|SS7|Diameter|PLC|SCADA|critical infrastructure|AI|IT systems?|admins?|developers?|devs?|modules?|PHP|Drupal|web|mobile|phones?|games?|information|records?|files|leaked|secrets?)\\b"
    },
    {
      "label": "prompt injection",
      "pattern": "\\bprompt[ -]+injection\\b|\\bjailbreak(?:s|ing)?\\b",
      "incident": true,
      "context": "\\b(?:prompt|AI|LLM|model|chatbot|agent)\\b"
    },
    {
